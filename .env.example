# Leave empty in development to use Vite proxy (see vite.config.ts → localhost:8080).
# For production build, set the public API origin, no trailing slash:
# VITE_BACKEND_URL=https://api.your-domain.com

VITE_BACKEND_URL=

# process-raw-device-data Cloud Run (rerun day). Leave empty in dev to use Vite proxy `/process-raw`.
# Production: full origin, no trailing slash, e.g. https://process-raw-device-data-....run.app
VITE_PROCESS_RAW_URL=
